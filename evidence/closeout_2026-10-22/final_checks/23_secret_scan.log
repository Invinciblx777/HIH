$ bash -c 
  echo "-- private key blocks:";  grep -rIlE "BEGIN [A-Z ]*PRIVATE KEY" . || echo none
  echo "-- key / token files:";   find . \( -name "*.pem" -o -name "*.key" -o -name "tokens.json" -o -name ".env" -o -name "id_rsa*" -o -name "*.p12" \) | grep . || echo none
  echo "-- var/ or .venv/ dirs:"; find . \( -name var -o -name .venv \) -type d | grep . || echo none
  echo "-- credential-looking strings:"; grep -rIEn "(sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{30,}|hf_[A-Za-z0-9]{30,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|Authorization: *Bearer [A-Za-z0-9._-]{16,}|api[_-]?key[\"' :=]+[A-Za-z0-9]{24,})" . --exclude=*.mp4 --exclude=*.pdf --exclude=*.pptx --exclude=*.png --exclude=*.ttf --exclude=*.jpg | cut -c1-160 || true; echo "(end)"
  echo "-- anything containing a bearer-style token field in evidence JSON:"; grep -rIlE "\"(api_key|token|secret|password)\"" aegislab/evidence | head || true; echo "(end)"

