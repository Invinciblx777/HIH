  {"key": "w08", "visual": {"kind": "screen", "files": ["04_audit_anomaly_desktop.png"], "what": "Audit page, anomaly detectors"},
   "caption": "The audit page lists {{detectors.n+}}. The scripted red agent's probes fired two of them, and both alerts are signed entries in the log."},
  {"key": "w09", "visual": {"kind": "screen", "files": ["05_evidence_verify_desktop.png", "06_evidence_tamper_desktop.png"], "what": "Evidence page, verify and tamper"},
